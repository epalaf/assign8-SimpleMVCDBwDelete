
<!doctype html>
<html lang="en".

<head>
   <meta charset = "utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <title>List Users</title>
   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
	integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>


<body>
   <nav class ="navbar bg-body-tertiary mb-4">
	<div class="container-fluid">
	   <span class="navbar-brand mb-0 h1">USER Management</span>
	</div>
   </nav>
   <div class ="container">
	<div class="row">
	   <div class="col-4 bg-light p-3">
		<form action="/users" method="get">
		   <button type="submit" class ="btn-primary m-2">Add User</button>
		</form>
	    </div>
	    <div class="col-8">
		<table class="tale table-striped">
		   <thead>
		      <tr>
			 <th>ID</th>
			 <th>First Name</th>
			 <th>Last Name</th>
			 <th>User Name</th>
			 <th>Password</th>
		      </tr>
		   </thead>
		   <tbody>
  		      <% items.forEach(item => { %>
     			 <tr>
          		    <td>
				<%= item.userID %>
			    </td>
			    <td>
				<%= item.fname %>
			    </td>
			    <td>
				<%= item.lname %>
			    </td>
			    <td>
				<%= item.username %>
			    </td>
			    <td>
				<%= item.passwd %>
			    <td>
	  		    <form
				action="/"
				method="post"
				style="display:inline;"
				onsubmit="return confirm('delete item: <%= item.userID %>?');"
			    >
	    		    <button type="submit" class="btn btn-danger">Delete</button>
	 		    </form>
      		    	 </tr>
     			 <% }); %>
		     </body>
		  </table>
	        </div>
	    </div>
      </div>
</body>

</html>
